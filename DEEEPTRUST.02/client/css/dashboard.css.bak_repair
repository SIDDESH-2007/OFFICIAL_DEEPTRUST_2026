/* ============================================================
   DEEPTRUST ENTERPRISE DASHBOARD & SECURITY CONSOLE STYLES
   ============================================================ */

:root {
  --bg-primary: #060B16;
  --bg-secondary: #0B1220;
  --surface-card: #111A2B;
  --surface-elevated: #162238;
  --surface-glass: rgba(17, 26, 43, 0.85);
  --surface-hover: rgba(30, 41, 69, 0.6);
  --surface-border: rgba(148, 163, 184, 0.12);
  --surface-border-focus: rgba(99, 102, 241, 0.5);

  --primary-indigo: #6366f1;
  --primary-blue: #3b82f6;
  --primary-glow: rgba(99, 102, 241, 0.25);
  --accent-cyan: #38bdf8;
  --accent-cyan-glow: rgba(56, 189, 248, 0.2);

  --success-emerald: #10b981;
  --success-glow: rgba(16, 185, 129, 0.2);
  --warning-amber: #f59e0b;
  --danger-red: #ef4444;
  --danger-glow: rgba(239, 68, 68, 0.2);

  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;

  --sidebar-width: 235px;
  --sidebar-collapsed-width: 64px;
  --topbar-height: 60px;

  --radius-xs: 4px;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;

  --transition-fast: 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-smooth: 0.28s cubic-bezier(0.4, 0, 0.2, 1);

  --font-sans: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --font-mono: 'JetBrains Mono', 'Fira Code', monospace;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body, html {
  width: 100%;
  height: 100%;
  font-family: var(--font-sans);
  background-color: var(--bg-primary);
  color: var(--text-primary);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* Background Subtle Gradient */
body::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 15% 15%, rgba(99, 102, 241, 0.05) 0%, transparent 50%),
              radial-gradient(circle at 85% 85%, rgba(56, 189, 248, 0.04) 0%, transparent 50%);
  pointer-events: none;
  z-index: 0;
}

/* Global Layout Shell */
.app-shell {
  display: flex;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* ============================================================
   1. SIDEBAR NAVIGATION
   ============================================================ */
.sidebar {
  width: var(--sidebar-width);
  background-color: var(--bg-secondary);
  border-right: 1px solid var(--surface-border);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  transition: width var(--transition-smooth);
}

.sidebar.collapsed {
  width: var(--sidebar-collapsed-width);
}

.sidebar-header {
  height: var(--topbar-height);
  padding: 0 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--surface-border);
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  overflow: hidden;
  white-space: nowrap;
}

.brand-icon {
  width: 38px;
  height: 38px;
  background: linear-gradient(135deg, var(--primary-indigo), var(--primary-blue));
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 800;
  font-size: 1.1rem;
  box-shadow: 0 4px 12px var(--primary-glow);
  flex-shrink: 0;
}

.brand-info {
  display: flex;
  flex-direction: column;
  transition: opacity var(--transition-fast);
}

.sidebar.collapsed .brand-info {
  display: none;
}

.brand-title {
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: #ffffff;
}

.brand-context {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent-cyan);
}

.sidebar-toggle {
  background: transparent;
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-xs);
  color: var(--text-secondary);
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: var(--transition-fast);
}

.sidebar-toggle:hover {
  color: var(--text-primary);
  background-color: var(--surface-hover);
  border-color: var(--primary-indigo);
}

.sidebar.collapsed .sidebar-toggle svg {
  transform: rotate(180deg);
}

.sidebar-nav {
  flex: 1;
  padding: 16px 10px;
  overflow-y: auto;
  overflow-x: hidden;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.nav-section-label {
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-muted);
  padding: 10px 12px 4px;
  white-space: nowrap;
}

.sidebar.collapsed .nav-section-label {
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-muted);
  padding: 10px 12px 4px;
  white-space: nowrap;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 14px;
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 13.5px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s ease;
  white-space: nowrap;
  position: relative;
}

.nav-item:hover {
  background-color: var(--surface-hover);
  color: var(--text-primary);
}
.nav-item:hover svg {
  transform: scale(1.05);
}
  color: var(--text-primary);
  background-color: var(--surface-hover);
}

.nav-item.active {
  color: #ffffff;
  background-color: var(--surface-elevated);
  border: 1px solid rgba(99, 102, 241, 0.3);
  box-shadow: inset 0 0 12px rgba(99, 102, 241, 0.1);
}

.nav-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 15%;
  bottom: 15%;
  width: 3px;
  background: linear-gradient(to bottom, var(--primary-indigo), var(--accent-cyan));
  border-radius: 0 4px 4px 0;
}

.nav-item svg {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  transition: transform 0.15s ease;
}

.sidebar.collapsed .nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 14px;
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 13.5px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s ease;
  white-space: nowrap;
  position: relative;
}

.sidebar.collapsed .nav-item span:not(.nav-badge) {
  display: none;
}

.nav-badge {
  margin-left: auto;
  padding: 2px 7px;
  border-radius: 12px;
  font-size: 0.7rem;
  font-weight: 700;
  background-color: rgba(239, 68, 68, 0.2);
  color: var(--danger-red);
  border: 1px solid rgba(239, 68, 68, 0.3);
}

.sidebar-footer {
  padding: 14px 12px;
  border-top: 1px solid var(--surface-border);
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.system-status-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11.5px;
  color: var(--text-secondary);
  padding: 6px 8px;
  background-color: rgba(16, 185, 129, 0.08);
  border: 1px solid rgba(16, 185, 129, 0.2);
  border-radius: var(--radius-xs);
  white-space: nowrap;
}

.sidebar.collapsed .system-status-indicator span {
  display: none;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--success-emerald);
  box-shadow: 0 0 8px var(--success-glow);
  flex-shrink: 0;
}

.status-dot.pulsing {
  animation: pulse 2s infinite ease-in-out;
}

@keyframes pulse {
  0% { transform: scale(0.95); opacity: 0.8; }
  50% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(0.95); opacity: 0.8; }
}

/* ============================================================
   2. MAIN CONTENT AREA & TOPBAR
   ============================================================ */
.main-wrapper {
  flex: 1;
  margin-left: var(--sidebar-width);
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  transition: margin-left var(--transition-smooth);
}

.sidebar.collapsed + .main-wrapper {
  margin-left: var(--sidebar-collapsed-width);
}

.topbar {
  height: var(--topbar-height);
  background-color: rgba(6, 11, 22, 0.8);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--surface-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
  position: sticky;
  top: 0;
  z-index: 90;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 16px;
}

.page-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--text-muted);
}

.page-breadcrumb .current-crumb {
  font-weight: 600;
  color: var(--text-primary);
}

.topbar-search {
  position: relative;
  width: 320px;
}

.topbar-search input {
  width: 100%;
  padding: 9px 14px 9px 38px;
  background-color: var(--surface-card);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
  font-size: 0.85rem;
  font-family: inherit;
  transition: var(--transition-fast);
}

.topbar-search input:focus {
  outline: none;
  border-color: var(--primary-indigo);
  box-shadow: 0 0 0 3px var(--primary-glow);
}

.topbar-search svg {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-muted);
  width: 16px;
  height: 16px;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 16px;
}

.health-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
  background-color: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.25);
  color: var(--success-emerald);
}

.notify-trigger {
  position: relative;
  background: var(--surface-card);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-sm);
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  cursor: pointer;
  transition: var(--transition-fast);
}

.notify-trigger:hover {
  background-color: var(--surface-hover);
  color: var(--text-primary);
  border-color: var(--primary-indigo);
}

.notify-count-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  background-color: var(--danger-red);
  color: #fff;
  font-size: 0.65rem;
  font-weight: 700;
  min-width: 18px;
  height: 18px;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 4px;
  border: 2px solid var(--bg-primary);
}

.user-profile-menu-wrap {
  position: relative;
}

.user-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 4px 10px 4px 6px;
  background-color: var(--surface-card);
  border: 1px solid var(--surface-border);
  border-radius: 24px;
  cursor: pointer;
  transition: var(--transition-fast);
}

.user-chip:hover {
  background-color: var(--surface-hover);
  border-color: var(--surface-border-focus);
}

.user-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-indigo), var(--primary-blue));
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 700;
  font-size: 0.8rem;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.user-meta {
  display: flex;
  flex-direction: column;
  text-align: left;
}

.user-meta-name {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.2;
}

.user-meta-role {
  font-size: 11.5px;
  color: var(--accent-cyan);
}

.profile-dropdown {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  width: 220px;
  background-color: var(--surface-card);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-md);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
  padding: 8px;
  display: none;
  flex-direction: column;
  gap: 4px;
  z-index: 200;
}

.profile-dropdown.show {
  display: flex;
  animation: fadeInDown 0.18s ease-out;
}

@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-6px); }
  to { opacity: 1; transform: translateY(0); }
}

.profile-dropdown-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 14px;
  border-radius: var(--radius-xs);
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 0.82rem;
  cursor: pointer;
  background: none;
  border: none;
  width: 100%;
  text-align: left;
  transition: var(--transition-fast);
}

.profile-dropdown-item:hover {
  background-color: var(--surface-hover);
  color: var(--text-primary);
}

.profile-dropdown-item.danger:hover {
  background-color: rgba(239, 68, 68, 0.15);
  color: var(--danger-red);
}

/* ============================================================
   3. CONTENT VIEWS & GRID CONTAINER
   ============================================================ */
.content-area {
  flex: 1;
  padding: 22px;
  max-width: 1520px;
  width: 100%;
  margin: 0 auto;
}

.view-section {
  display: none;
  animation: viewFadeIn 0.2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

.view-section.active {
  display: block;
}

@keyframes viewFadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}
  to { opacity: 1; transform: translateY(0); }
}

.view-header {
  margin-bottom: 24px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}

.view-greeting {
  font-size: clamp(24px, 2vw, 26px);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: #ffffff;
  margin-bottom: 4px;
}

.view-subtitle {
  font-size: clamp(14px, 1.2vw, 15px);
  color: var(--text-secondary);
}

.view-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

/* KPI CARDS GRID */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.kpi-card {
  background-color: var(--surface-card);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-lg);
  padding: 18px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 150px;
  gap: 12px;
  transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  overflow: hidden;
  animation: viewFadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
}

.kpi-card:hover {
  transform: translateY(-3px);
  border-color: rgba(99, 102, 241, 0.4);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
}

.kpi-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--primary-indigo), transparent);
  opacity: 0;
  transition: opacity var(--transition-fast);
}

.kpi-card:hover::before {
  opacity: 1;
}

.kpi-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.kpi-title {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.kpi-icon {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  flex-shrink: 0;
}
.kpi-icon svg { width: 18px; height: 18px; }

.kpi-icon.indigo { background-color: rgba(99, 102, 241, 0.15); color: var(--primary-indigo); }
.kpi-icon.emerald { background-color: rgba(16, 185, 129, 0.15); color: var(--success-emerald); }
.kpi-icon.amber { background-color: rgba(245, 158, 11, 0.15); color: var(--warning-amber); }
.kpi-icon.red { background-color: rgba(239, 68, 68, 0.15); color: var(--danger-red); }
.kpi-icon.cyan { background-color: rgba(56, 189, 248, 0.15); color: var(--accent-cyan); }

.kpi-value {
  font-size: clamp(30px, 3vw, 36px);
  font-weight: 700;
  letter-spacing: -0.03em;
  color: #ffffff;
  font-family: var(--font-sans);
}

.kpi-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 12.5px;
  color: var(--text-muted);
}

.kpi-subtext {
  display: flex;
  align-items: center;
  gap: 4px;
}

.kpi-subtext.positive { color: var(--success-emerald); }
.kpi-subtext.warning { color: var(--warning-amber); }
.kpi-subtext.danger { color: var(--danger-red); }

/* DASHBOARD SPLIT GRIDS */
.dash-row-2 {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 16px;
  margin-bottom: 24px;
}

.dash-row-equal {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 24px;
}

@media (max-width: 1100px) {
  .dash-row-2, .dash-row-equal {
    grid-template-columns: 1fr;
  }
}

.card {
  background-color: var(--surface-card);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-lg);
  padding: 22px;
  display: flex;
  flex-direction: column;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
  flex-wrap: wrap;
  gap: 12px;
}

.card-title {
  font-size: clamp(17px, 1.5vw, 19px);
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 8px;
}

.card-title svg {
  width: 18px;
  height: 18px;
  color: var(--primary-indigo);
}

.filter-btn-group {
  display: flex;
  background-color: var(--bg-primary);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-sm);
  padding: 2px;
}

.filter-btn {
  background: transparent;
  border: none;
  padding: 4px 10px;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-secondary);
  border-radius: var(--radius-xs);
  cursor: pointer;
  transition: var(--transition-fast);
}

.filter-btn:hover {
  color: var(--text-primary);
}

.filter-btn.active {
  background-color: var(--surface-elevated);
  color: #ffffff;
}

/* CHART SVG WRAPPER */
.chart-container {
  width: 100%;
  height: 240px;
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-top: 20px;
}

.trend-bars-wrapper {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-end;
  gap: 16px;
  justify-content: space-around;
  padding-bottom: 24px;
}

.trend-bar-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
  gap: 6px;
  flex: 1;
}

.bar-stack {
  width: 100%;
  max-width: 28px;
  background-color: var(--surface-elevated);
  border-radius: 4px 4px 0 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  position: relative;
  overflow: hidden;
}

.bar-segment {
  width: 100%;
  transition: height 0.4s ease-out;
}

.bar-segment.verified { background: linear-gradient(to top, #10b981, #34d399); }
.bar-segment.failed { background: linear-gradient(to top, #f59e0b, #fbbf24); }
.bar-segment.blocked { background: linear-gradient(to top, #ef4444, #f87171); }

.bar-label {
  font-size: 0.7rem;
  color: var(--text-muted);
  white-space: nowrap;
}

.chart-legend {
  display: flex;
  align-items: center;
  gap: 16px;
  justify-content: center;
  margin-top: 12px;
  font-size: 0.78rem;
  color: var(--text-secondary);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
}

.legend-dot {
  width: 8px;
  height: 8px;
  border-radius: 2px;
}

.legend-dot.verified { background-color: var(--success-emerald); }
.legend-dot.failed { background-color: var(--warning-amber); }
.legend-dot.blocked { background-color: var(--danger-red); }

/* RISK OVERVIEW CARD */
.risk-meter-wrap {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 10px 0;
}

.risk-level-bar {
  display: flex;
  height: 12px;
  border-radius: 6px;
  overflow: hidden;
  gap: 2px;
  background-color: var(--bg-primary);
}

.risk-level-segment {
  height: 100%;
  transition: width 0.3s ease;
}

.risk-level-segment.low { background-color: var(--success-emerald); }
.risk-level-segment.medium { background-color: var(--warning-amber); }
.risk-level-segment.high { background-color: #f97316; }
.risk-level-segment.critical { background-color: var(--danger-red); }

.risk-metric-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}

.risk-metric-pill {
  padding: 10px 14px;
  background-color: var(--surface-elevated);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.risk-metric-label {
  font-size: 0.78rem;
  color: var(--text-secondary);
}

.risk-metric-count {
  font-size: 1.1rem;
  font-weight: 700;
  color: #fff;
}

/* VERIFICATION FACTOR HEALTH */
.factor-health-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 12px;
}

.factor-health-item {
  padding: 10px 12px;
  background-color: var(--surface-elevated);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.factor-info-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.factor-status-badge {
  padding: 3px 8px;
  border-radius: 12px;
  font-size: 11.5px;
  font-weight: 600;
  background-color: rgba(16, 185, 129, 0.15);
  color: var(--success-emerald);
  border: 1px solid rgba(16, 185, 129, 0.3);
}

.factor-status-badge.degraded {
  background-color: rgba(245, 158, 11, 0.15);
  color: var(--warning-amber);
  border-color: rgba(245, 158, 11, 0.3);
}

/* ============================================================
   4. DATA TABLES & STATUS PILLS
   ============================================================ */
.table-responsive {
  width: 100%;
  overflow-x: auto;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 0.85rem;
}

.data-table th {
  padding: 10px 12px;
  color: var(--text-muted);
  font-size: 11.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 1px solid var(--surface-border);
  background-color: rgba(6, 11, 22, 0.4);
}

.data-table td {
  padding: 10px 12px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.06);
  color: var(--text-primary);
  vertical-align: middle;
  font-size: 12.5px;
}

.data-table tbody tr {
  transition: background-color var(--transition-fast);
}

.data-table tbody tr:hover {
  background-color: var(--surface-hover);
  cursor: pointer;
}

.factor-check-list {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-mono);
  font-size: 0.72rem;
}

.factor-tag {
  padding: 2px 6px;
  border-radius: 4px;
  font-weight: 600;
}

.factor-tag.pass {
  background-color: rgba(16, 185, 129, 0.15);
  color: var(--success-emerald);
  border: 1px solid rgba(16, 185, 129, 0.3);
}

.factor-tag.fail {
  background-color: rgba(239, 68, 68, 0.15);
  color: var(--danger-red);
  border: 1px solid rgba(239, 68, 68, 0.3);
}

.status-pill {
  padding: 3px 8px;
  border-radius: 12px;
  font-size: 11.5px;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  text-transform: uppercase;
}

.status-pill.allow, .status-pill.verified, .status-pill.active, .status-pill.resolved {
  background-color: rgba(16, 185, 129, 0.15);
  color: var(--success-emerald);
  border: 1px solid rgba(16, 185, 129, 0.3);
}

.status-pill.block, .status-pill.critical, .status-pill.high, .status-pill.denied {
  background-color: rgba(239, 68, 68, 0.15);
  color: var(--danger-red);
  border: 1px solid rgba(239, 68, 68, 0.3);
}

.status-pill.medium, .status-pill.warning, .status-pill.pending, .status-pill.step-up {
  background-color: rgba(245, 158, 11, 0.15);
  color: var(--warning-amber);
  border: 1px solid rgba(245, 158, 11, 0.3);
}

.status-pill.low, .status-pill.open, .status-pill.info {
  background-color: rgba(56, 189, 248, 0.15);
  color: var(--accent-cyan);
  border: 1px solid rgba(56, 189, 248, 0.3);
}

/* ============================================================
   5. RIGHT INVESTIGATION DRAWER & NOTIFICATION DRAWER
   ============================================================ */
.drawer-backdrop {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  z-index: 500;
  display: none;
}

.drawer-backdrop.open {
  display: block;
}

.investigation-drawer, .notification-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 480px;
  max-width: 90vw;
  background-color: var(--surface-card);
  border-left: 1px solid var(--surface-border);
  box-shadow: -8px 0 32px rgba(0, 0, 0, 0.6);
  z-index: 600;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
}

.investigation-drawer.open, .notification-drawer.open {
  transform: translateX(0);
}

.drawer-header {
  padding: 18px 24px;
  border-bottom: 1px solid var(--surface-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.drawer-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: #fff;
}

.drawer-close-btn {
  background: transparent;
  border: none;
  color: var(--text-secondary);
  cursor: pointer;
  width: 32px;
  height: 32px;
  border-radius: var(--radius-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition-fast);
}

.drawer-close-btn:hover {
  background-color: var(--surface-hover);
  color: #fff;
}

.drawer-body {
  flex: 1;
  overflow-y: auto;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.drawer-footer {
  padding: 18px 24px;
  border-top: 1px solid var(--surface-border);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12px;
  background-color: var(--bg-secondary);
}

/* Investigation Detail Groups */
.detail-section-title {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
  margin-bottom: 8px;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.detail-box {
  background-color: var(--surface-elevated);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-sm);
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.detail-box-label {
  font-size: 0.72rem;
  color: var(--text-muted);
}

.detail-box-value {
  font-size: 0.88rem;
  font-weight: 600;
  color: #ffffff;
}

.reason-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.reason-tag {
  background-color: rgba(239, 68, 68, 0.12);
  color: #fca5a5;
  border: 1px solid rgba(239, 68, 68, 0.25);
  border-radius: var(--radius-xs);
  padding: 4px 8px;
  font-size: 0.75rem;
  font-family: var(--font-mono);
}

/* Timeline List */
.timeline-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  border-left: 2px solid var(--surface-border);
  margin-left: 8px;
  padding-left: 16px;
}

.timeline-entry {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.timeline-entry::before {
  content: '';
  position: absolute;
  left: -21px;
  top: 4px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--primary-indigo);
  border: 2px solid var(--surface-card);
}

.timeline-time {
  font-size: 0.72rem;
  color: var(--text-muted);
}

.timeline-action {
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--text-primary);
}

/* BUTTONS */
.btn {
  padding: 8px 16px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1px solid transparent;
  font-family: inherit;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary-indigo), var(--primary-blue));
  color: #ffffff;
  box-shadow: 0 4px 12px var(--primary-glow);
}

.btn-primary:hover {
  opacity: 0.92;
  transform: translateY(-1px) scale(1.02);
}

.btn-secondary {
  background-color: var(--surface-elevated);
  border-color: var(--surface-border);
  color: var(--text-primary);
}

.btn-secondary:hover {
  background-color: var(--surface-hover);
  border-color: var(--surface-border-focus);
}

.btn-danger {
  background-color: rgba(239, 68, 68, 0.15);
  border-color: rgba(239, 68, 68, 0.3);
  color: var(--danger-red);
}

.btn-danger:hover {
  background-color: rgba(239, 68, 68, 0.25);
}

.btn-success {
  background-color: rgba(16, 185, 129, 0.15);
  border-color: rgba(16, 185, 129, 0.3);
  color: var(--success-emerald);
}

.btn-success:hover {
  background-color: rgba(16, 185, 129, 0.25);
}

/* ============================================================
   6. AI SECURITY COPILOT VIEW (DEEPTRUST ADMIN)
   ============================================================ */
.copilot-container {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 24px;
  min-height: 600px;
}

@media (max-width: 1024px) {
  .copilot-container {
    grid-template-columns: 1fr;
  }
}

.copilot-chat-pane {
  background-color: var(--surface-card);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.copilot-header {
  padding: 16px 20px;
  border-bottom: 1px solid var(--surface-border);
  display: flex;
  align-items: center;
  gap: 12px;
  background-color: rgba(6, 11, 22, 0.4);
}

.copilot-badge {
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 0.72rem;
  font-weight: 700;
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(56, 189, 248, 0.2));
  color: var(--accent-cyan);
  border: 1px solid rgba(56, 189, 248, 0.3);
}

.copilot-conversation {
  flex: 1;
  padding: 20px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.copilot-message {
  padding: 14px 18px;
  border-radius: var(--radius-md);
  font-size: 0.88rem;
  line-height: 1.5;
  max-width: 90%;
}

.copilot-message.user {
  align-self: flex-end;
  background-color: var(--primary-indigo);
  color: #fff;
  border-bottom-right-radius: 4px;
}

.copilot-message.agent {
  align-self: flex-start;
  background-color: var(--surface-elevated);
  border: 1px solid var(--surface-border);
  color: var(--text-primary);
  border-bottom-left-radius: 4px;
}

.copilot-message-title {
  font-weight: 700;
  color: var(--accent-cyan);
  margin-bottom: 6px;
}

.copilot-suggestions {
  padding: 12px 20px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  border-top: 1px solid var(--surface-border);
  background-color: rgba(6, 11, 22, 0.3);
}

.copilot-chip {
  background-color: var(--surface-elevated);
  border: 1px solid var(--surface-border);
  border-radius: 16px;
  padding: 6px 12px;
  font-size: 0.76rem;
  color: var(--text-secondary);
  cursor: pointer;
  transition: var(--transition-fast);
}

.copilot-chip:hover {
  color: var(--text-primary);
  border-color: var(--primary-indigo);
  background-color: var(--surface-hover);
}

.copilot-input-bar {
  padding: 16px 20px;
  border-top: 1px solid var(--surface-border);
  display: flex;
  gap: 10px;
}

.copilot-input-bar input {
  flex: 1;
  padding: 10px 16px;
  background-color: var(--bg-primary);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
  font-family: inherit;
  font-size: 0.88rem;
}

.copilot-input-bar input:focus {
  outline: none;
  border-color: var(--primary-indigo);
}

.copilot-evidence-pane {
  background-color: var(--surface-card);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-lg);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.evidence-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.evidence-item {
  padding: 10px 14px;
  background-color: var(--surface-elevated);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-sm);
  font-size: 0.8rem;
  font-family: var(--font-mono);
  color: var(--text-secondary);
}

.recommendations-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.recommendation-item {
  padding: 10px 14px;
  background-color: rgba(99, 102, 241, 0.08);
  border: 1px solid rgba(99, 102, 241, 0.2);
  border-radius: var(--radius-sm);
  font-size: 0.82rem;
  color: var(--text-primary);
  display: flex;
  align-items: flex-start;
  gap: 8px;
}

/* ============================================================
   7. SKELETON LOADERS, EMPTY & ERROR STATES
   ============================================================ */
.skeleton {
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.03) 25%, rgba(255, 255, 255, 0.08) 37%, rgba(255, 255, 255, 0.03) 63%);
  background-size: 400% 100%;
  animation: skeletonShimmer 1.4s ease infinite;
  border-radius: var(--radius-xs);
}

@keyframes skeletonShimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.empty-state {
  padding: 48px 24px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: var(--text-secondary);
}

.empty-state-icon {
  width: 48px;
  height: 48px;
  color: var(--text-muted);
}

.empty-state-title {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-state-desc {
  font-size: 0.85rem;
  max-width: 360px;
}

.error-state {
  padding: 32px;
  background-color: rgba(239, 68, 68, 0.08);
  border: 1px solid rgba(239, 68, 68, 0.25);
  border-radius: var(--radius-md);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .sidebar {
    transform: translateX(-100%);
  }
  .sidebar.mobile-open {
    transform: translateX(0);
  }
  .main-wrapper {
    margin-left: 0 !important;
  }
  .topbar {
    padding: 0 16px;
  }
  .topbar-search {
    display: none;
  }
  .content-area {
  flex: 1;
  padding: 22px;
  max-width: 1520px;
  width: 100%;
  margin: 0 auto;
}
}


.sidebar-nav::-webkit-scrollbar {
  width: 4px;
}
.sidebar-nav::-webkit-scrollbar-track {
  background: transparent;
}
.sidebar-nav::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4px;
}

.metric-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.2);
}
.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 14px;
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 13.5px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s ease;
  white-space: nowrap;
  position: relative;
}

.kpi-card:nth-child(1) { animation-delay: 0.02s; }
.kpi-card:nth-child(2) { animation-delay: 0.05s; }
.kpi-card:nth-child(3) { animation-delay: 0.08s; }
.kpi-card:nth-child(4) { animation-delay: 0.11s; }

.data-table td {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 250px;
}

/* NEW NORMALIZED FORMS */
.form-group {
  margin-bottom: 16px;
}
.form-label {
  display: block;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 6px;
}
.form-input, .form-select {
  width: 100%;
  height: 40px;
  padding: 8px 12px;
  background-color: var(--surface-elevated);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
  font-size: 13.5px;
  font-family: inherit;
  transition: border-color 0.15s ease;
}
.form-input:focus, .form-select:focus {
  outline: none;
  border-color: var(--primary-indigo);
  box-shadow: 0 0 0 2px var(--primary-glow);
}
.form-helper {
  font-size: 11.5px;
  color: var(--text-muted);
  margin-top: 4px;
}

/* SEARCH */
.topbar-search input {
  height: 38px;
  font-size: 13.5px;
}

/* BUTTONS */
.btn {
  height: 38px;
  padding: 0 16px;
  font-size: 13px;
  border-radius: var(--radius-sm);
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1px solid transparent;
}
.btn-sm {
  height: 32px;
  padding: 0 12px;
  font-size: 12px;
}
.btn-lg {
  height: 44px;
  padding: 0 20px;
  font-size: 14px;
}
.btn-icon {
  width: 38px;
  height: 38px;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* MODALS */
.modal-overlay {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  animation: fadeIn 0.2s ease-out;
}
.modal-content {
  background-color: var(--surface-card);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-lg);
  width: 100%;
  max-width: 500px;
  max-height: calc(100vh - 48px);
  display: flex;
  flex-direction: column;
  box-shadow: 0 24px 48px rgba(0,0,0,0.5);
  animation: slideUp 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}
.modal-header {
  padding: 16px 20px;
  border-bottom: 1px solid var(--surface-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.modal-title {
  font-size: 17px;
  font-weight: 700;
}
.modal-body {
  padding: 20px;
  overflow-y: auto;
}
.modal-footer {
  padding: 16px 20px;
  border-top: 1px solid var(--surface-border);
  display: flex;
  justify-content: flex-end;
  gap: 12px;
}

/* TABLES */
.data-table th {
  padding: 10px 12px;
  font-size: 11.5px;
  height: 40px;
}
.data-table td {
  padding: 8px 12px;
  font-size: 12.5px;
  height: 44px;
}

/* DRAWERS */
.drawer {
  width: 400px;
  max-width: 90vw;
}
.drawer-header {
  padding: 16px 20px;
}
.drawer-body {
  padding: 20px;
}

/* PROFILE MENU */
.profile-dropdown {
  width: 200px;
}
.profile-dropdown-item {
  padding: 8px 12px;
  font-size: 13px;
}

/* SETTINGS */
.settings-section {
  background: var(--surface-card);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-lg);
  padding: 24px;
  margin-bottom: 24px;
}
.settings-title {
  font-size: 17px;
  font-weight: 700;
  margin-bottom: 16px;
}

/* ANIMATIONS */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes slideUp {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

/* OVERFLOW REPAIRS */
.table-responsive {
  max-width: 100%;
  overflow-x: auto;
}


/* ============================================================================
   DEEPTRUST FRONTEND REWORK v2 - ABSOLUTE LAYOUT FIX
   ============================================================================ */

/* 1. ABSOLUTE MAIN WIDTH REPAIR */
:root {
  --sidebar-width: 228px;
  --topbar-height: 58px;
}

body, html {
  margin: 0;
  padding: 0;
  width: 100%;
  overflow-x: hidden !important; /* Safety catch at page level */
  font-size: 13px !important;
  font-family: var(--font-sans), sans-serif !important;
}

.app-shell {
  display: flex !important;
  width: 100vw !important;
  max-width: 100% !important;
  min-height: 100vh !important;
  overflow-x: hidden !important;
  position: relative;
}

.sidebar {
  width: var(--sidebar-width) !important;
  height: 100vh !important;
  position: fixed !important;
  top: 0; left: 0;
  display: flex !important;
  flex-direction: column !important;
  z-index: 100;
}

.main-wrapper {
  margin-left: var(--sidebar-width) !important;
  width: calc(100vw - var(--sidebar-width)) !important;
  max-width: calc(100vw - var(--sidebar-width)) !important;
  min-width: 0 !important;
  flex: 1 1 auto !important;
  display: flex !important;
  flex-direction: column !important;
  min-height: 100vh !important;
}

.content-area {
  flex: 1 1 auto !important;
  padding: 20px !important;
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;
  box-sizing: border-box !important;
}

/* 2. SIDEBAR VERTICAL FIT (NO SCROLL) */
.sidebar-header {
  flex: 0 0 56px !important;
  height: 56px !important;
  padding: 0 14px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
}

.sidebar-nav {
  flex: 1 1 auto !important;
  min-height: 0 !important; /* Critical for flex scrolling/containment */
  overflow-y: hidden !important; /* NO SCROLL BAR */
  overflow-x: hidden !important;
  padding: 8px 12px !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 2px !important;
}

.nav-section-label {
  font-size: 10px !important;
  padding: 8px 10px 2px 10px !important;
  margin-top: 2px !important;
  color: var(--text-muted) !important;
}

.nav-item {
  height: 38px !important;
  min-height: 38px !important;
  padding: 0 10px !important;
  gap: 10px !important;
  font-size: 13px !important;
  display: flex !important;
  align-items: center !important;
}

.nav-item svg {
  width: 17px !important;
  height: 17px !important;
  flex-shrink: 0 !important;
}

.sidebar-footer {
  flex: 0 0 54px !important;
  height: 54px !important;
  padding: 8px 12px !important;
  display: flex !important;
  align-items: center !important;
}

.system-status-indicator {
  width: 100% !important;
  height: 36px !important;
  padding: 0 10px !important;
  font-size: 11px !important;
  display: flex !important;
  align-items: center !important;
  gap: 8px !important;
}

/* 3. TOPBAR COMPACTING */
.topbar {
  height: var(--topbar-height) !important;
  flex: 0 0 var(--topbar-height) !important;
  padding: 0 20px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.page-breadcrumb {
  font-size: 12.5px !important;
}

.topbar-search {
  width: clamp(200px, 25vw, 320px) !important;
  position: relative !important;
}

.topbar-search input {
  height: 36px !important;
  font-size: 13px !important;
  padding-left: 32px !important;
  width: 100% !important;
}

.topbar-search svg {
  width: 14px !important;
  height: 14px !important;
  left: 10px !important;
}

.health-badge {
  height: 30px !important;
  padding: 0 10px !important;
  font-size: 11px !important;
  display: flex !important;
  align-items: center !important;
}

.notify-trigger {
  width: 32px !important;
  height: 32px !important;
}

.user-chip {
  height: 34px !important;
  padding: 2px 10px 2px 2px !important;
}

.user-avatar {
  width: 30px !important;
  height: 30px !important;
  font-size: 11.5px !important;
}

.user-meta-name { font-size: 13px !important; }
.user-meta-role { font-size: 11px !important; }

/* 4. DASHBOARD PAGE HEADERS */
.view-greeting {
  font-size: 24px !important;
  margin-bottom: 4px !important;
}

.view-subtitle {
  font-size: 13.5px !important;
}

.view-header {
  margin-bottom: 18px !important;
}

/* 5. METRIC CARDS RESPONSIVE GRID */
.kpi-grid {
  display: grid !important;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)) !important;
  gap: 14px !important;
  margin-bottom: 18px !important;
  width: 100% !important;
}

.kpi-card {
  height: 140px !important;
  padding: 16px !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: space-between !important;
  min-width: 0 !important; /* Prevent blowout */
}

.kpi-title { font-size: 12.5px !important; }
.kpi-value { font-size: 30px !important; line-height: 1.1 !important; }
.kpi-footer { font-size: 11.5px !important; }
.kpi-icon { width: 32px !important; height: 32px !important; }
.kpi-icon svg { width: 16px !important; height: 16px !important; }

/* 6. MAIN CONTENT GRIDS (e.g., Tables & Factors) */
.dash-row-2 {
  display: grid !important;
  grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) !important; /* Critical minmax for grid children overflow */
  gap: 16px !important;
  width: 100% !important;
}

@media (max-width: 1366px) {
  .dash-row-2 {
    grid-template-columns: 1fr !important;
  }
}

.card {
  padding: 18px !important;
  min-width: 0 !important;
}

.card-title {
  font-size: 14.5px !important;
}

/* 7. TABLES - RESPONSIVE & COMPACT */
.table-responsive {
  width: 100% !important;
  overflow-x: auto !important; /* Local scrolling ONLY if needed */
}

.data-table {
  width: 100% !important;
  table-layout: fixed !important; /* Critical to prevent expansion */
  min-width: 700px !important; /* Minimum comfortable width before scroll */
}

.data-table th {
  font-size: 11px !important;
  height: 38px !important;
  padding: 0 10px !important;
}

.data-table td {
  font-size: 12.5px !important;
  height: 44px !important;
  padding: 0 10px !important;
  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
}

/* Column Width Strategy for Identity Table */
.data-table th:nth-child(1), .data-table td:nth-child(1) { width: 18% !important; } /* Name */
.data-table th:nth-child(2), .data-table td:nth-child(2) { width: 22% !important; } /* Email */
.data-table th:nth-child(3), .data-table td:nth-child(3) { width: 15% !important; } /* Org */
.data-table th:nth-child(4), .data-table td:nth-child(4) { width: 12% !important; } /* Role */
/* Factors get remaining width */

/* 8. BADGES */
.status-pill, .factor-status-badge, .nav-badge {
  font-size: 10.5px !important;
  padding: 3px 8px !important;
  height: auto !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  white-space: nowrap !important;
}

/* 9. BUTTONS */
.btn {
  font-size: 12.5px !important;
  height: 36px !important;
  padding: 0 14px !important;
}
.btn-sm {
  font-size: 11.5px !important;
  height: 30px !important;
  padding: 0 10px !important;
}

/* 10. FORMS */
.form-input, .form-select {
  font-size: 13px !important;
  height: 38px !important;
  padding: 0 12px !important;
}
.form-label {
  font-size: 12px !important;
}

/* 11. ANIMATIONS */
.view-section {
  animation: pageEntry 0.2s ease-out forwards !important;
}
@keyframes pageEntry {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

