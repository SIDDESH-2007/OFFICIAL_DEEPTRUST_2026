# Set these in Render secrets. Never commit real values.
NODE_ENV=production
PORT=5000
AI_SERVICE_URL=http://127.0.0.1:8000
JWT_SECRET=
AUDIT_SIGNING_KEY=
MONGODB_URI=
MONGODB_DATABASE=deeptrust
FRONTEND_ORIGINS=https://YOUR-FRONTEND.vercel.app
FASTAPI_CORS_ORIGINS=https://YOUR-FRONTEND.vercel.app
ENABLE_DEMO_SEEDING=false
AUDIT_CHECKPOINT_PATH=/var/lib/deeptrust/audit/checkpoint.json
DEEPTRUST_MODEL_DIR=/var/lib/deeptrust/models
DEEPTRUST_VOICE_MODEL_DIR=/var/lib/deeptrust/voice_models
